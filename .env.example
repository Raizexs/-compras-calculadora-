# ====================================
# Ejemplo de Variables de Entorno
# ====================================
# 
# IMPORTANTE: 
# 1. Copia este archivo como .env
# 2. Nunca subas el archivo .env a Git
# 3. Completa con tus propios valores
#

# ====================================
# Tasas de Cambio (Opcional - puedes usar APIs)
# ====================================
USD_TO_CLP=950
EUR_TO_CLP=1050

# ====================================
# API Keys (Si decides usar APIs externas)
# ====================================
# EXCHANGE_RATE_API_KEY=tu_api_key_aqui
# FIREBASE_API_KEY=tu_firebase_key_aqui
# GOOGLE_MAPS_API_KEY=tu_google_maps_key_aqui

# ====================================
# Configuración de la App
# ====================================
# APP_NAME=Calculadora de Compras
# APP_VERSION=1.0.0
# ENVIRONMENT=development

# ====================================
# Analytics (Opcional)
# ====================================
# GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
# MIXPANEL_TOKEN=tu_token_aqui

# ====================================
# Base de Datos (Si usas backend)
# ====================================
# API_BASE_URL=https://api.tu-backend.com
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ====================================
# Notificaciones Push (Opcional)
# ====================================
# EXPO_PUSH_TOKEN=ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]
# ONE_SIGNAL_APP_ID=tu_onesignal_app_id
